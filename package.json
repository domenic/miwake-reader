{
  "name": "miwake-reader",
  "version": "2.0.0",
  "license": "BSD-3-Clause",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "husky && svelte-kit sync && npm run generate-fixtures",
    "check": "npm run check:lint && npm run check:format && npm run check:types",
    "check:lint": "eslint .",
    "check:format": "prettier --check .",
    "check:types": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint --fix .",
    "format": "prettier --write .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "playwright test",
    "generate-fixtures": "node scripts/generate-test-fixtures.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/path-browserify": "^1.0.3",
    "@types/webappsec-credential-management": "^0.6.9",
    "@types/wicg-file-system-access": "^2023.10.7",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-better-tailwindcss": "^4.5.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sharp": "^0.34.5",
    "svelte": "^5.56.2",
    "svelte-check": "^4.6.0",
    "svelte-eslint-parser": "^1.8.0",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@zip.js/zip.js": "^2.8.26",
    "balanced-match": "^4.0.4",
    "fake-indexeddb": "^6.2.5",
    "fast-xml-parser": "^5.8.0",
    "idb": "^8.0.3",
    "p-limit": "^7.3.0",
    "path-browserify": "^1.0.1",
    "svelte-fa": "^4.0.4",
    "svelte-gestures": "^5.2.2",
    "svelte-meta-tags": "^4.7.0"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,svelte}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,html,scss,yml,yaml}": "prettier --write"
  }
}
